@model IEnumerable<Ecommerce.Models.Cart>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<style>
    @@media (max-width: 768px) {
        .checkout-card { padding: 18px !important; border-radius: 16px !important; }
    }
</style>

<div class="container py-4 py-lg-5" style="overflow-x:hidden;">
<div class="row g-4">
<div class="col-lg-7 order-2 order-lg-1">
<div class="card border-0 shadow-sm rounded-4 p-4 checkout-card" style="box-shadow:0 10px 30px rgba(0,0,0,0.06) !important;">
<h5 class="fw-bold mb-4"><i class="fa-solid fa-truck-fast me-2"></i>Shipping Details</h5>
<form asp-action="PlaceOrder" method="post">
@Html.AntiForgeryToken()
<div class="mb-3"><label class="small fw-semibold mb-1">Full Name</label><input name="CustomerName" required class="form-control rounded-3 py-2" placeholder="Ali Khan" /></div>
<div class="mb-3"><label class="small fw-semibold mb-1">Phone Number</label><input name="Phone" required class="form-control rounded-3 py-2" placeholder="0300-1234567" type="tel" /></div>
<div class="mb-3"><label class="small fw-semibold mb-1">Full Address</label><textarea name="Address" required class="form-control rounded-3" rows="3" placeholder="House No, Street, City"></textarea></div>

<div class="mb-4">
<label class="small fw-semibold mb-1">Payment Method</label>
<select name="PaymentMethod" id="paymentMethod" class="form-select rounded-3 py-2" onchange="togglePay()" required>
<option value="Cash on Delivery">Cash on Delivery</option>
<option value="JazzCash">JazzCash</option>
<option value="EasyPaisa">EasyPaisa</option>
</select>

<div id="onlineBox" style="display:none;" class="mt-3 p-3 border rounded-3 bg-light">
<div class="small fw-bold mb-2"><i class="fa-solid fa-mobile-screen me-2"></i><span id="payTitle">JazzCash</span> Payment (Demo)</div>
<p class="small text-muted">Send Rs. @Convert.ToDecimal(ViewBag.FinalTotal ?? 0).ToString("N0") to <b>0300-1234567</b> and enter Txn ID below.</p>
<input name="TransactionId" class="form-control rounded-3" placeholder="Enter Txn ID e.g. TXN123456" />
</div>
</div>

<button class="btn btn-dark w-100 py-3 rounded-3 fw-bold"><i class="fa-solid fa-lock me-2"></i>Place Order - Rs. @Convert.ToDecimal(ViewBag.FinalTotal ?? 0).ToString("N0")</button>
<p class="text-center small text-muted mt-3"><i class="fa-solid fa-shield-halved me-1"></i>Secure & Safe Checkout</p>
</form>
</div>
</div>
<div class="col-lg-5 order-1 order-lg-2">
<div class="card border-0 shadow-sm rounded-4 p-4 checkout-card" style="position:sticky; top:90px; box-shadow:0 10px 30px rgba(0,0,0,0.06) !important;">
<h6 class="fw-bold mb-3">Order Summary <span class="text-muted fw-normal">(@Model.Count() items)</span></h6>
<div style="max-height:250px; overflow-y:auto;">
@foreach(var i in Model){
    var imgPath = i.Product!.Image ?? "";
    if (!imgPath.StartsWith("/") && !imgPath.StartsWith("http")) { imgPath = "/" + imgPath.TrimStart('~','/'); }
    <div class="d-flex gap-2 align-items-center mb-3">
        <img src="@Url.Content(imgPath)" style="width:44px; height:44px; object-fit:contain; background:#f6f7f9; border-radius:10px; padding:4px;" onerror="this.src='https://placehold.co/100x100?text=No'" />
        <div class="flex-grow-1" style="min-width:0;">
            <div class="small fw-semibold text-truncate" style="max-width:150px;">@i.Product!.Name</div>
            <div class="small text-muted" style="font-size:11px;">Qty: @i.Quantity</div>
        </div>
        <span class="small fw-bold">Rs. @((i.Product!.Price * i.Quantity).ToString("N0"))</span>
    </div>
}
</div>
<hr />
<div class="d-flex justify-content-between small mb-2"><span class="text-muted">Subtotal</span><span class="fw-semibold">Rs. @Convert.ToDecimal(ViewBag.Subtotal ?? 0).ToString("N0")</span></div>
<div class="d-flex justify-content-between small mb-2 text-success"><span>Discount 10%</span><span class="fw-semibold">- Rs. @Convert.ToDecimal(ViewBag.Discount ?? 0).ToString("N0")</span></div>
<div class="d-flex justify-content-between small mb-2"><span class="text-muted">Shipping</span><span class="fw-semibold text-success">Free</span></div>
<hr />
<div class="d-flex justify-content-between fw-bolder fs-5"><span>Total</span><span>Rs. @Convert.ToDecimal(ViewBag.FinalTotal ?? 0).ToString("N0")</span></div>
</div>
</div>
</div>
</div>

<script>
function togglePay(){
    var m = document.getElementById('paymentMethod').value;
    var box = document.getElementById('onlineBox');
    var title = document.getElementById('payTitle');
    if(m === 'Cash on Delivery'){ box.style.display='none'; }
    else { box.style.display='block'; title.innerText = m; }
}
</script>