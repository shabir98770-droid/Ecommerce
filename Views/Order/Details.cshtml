@model Ecommerce.Models.Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
    var subtotalBeforeDiscount = Model.OrderItems.Sum(i => i.Price * i.Quantity);
    var discount = subtotalBeforeDiscount - Model.TotalAmount;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<style>
    .detail-card{ border:0; box-shadow:0 10px 30px rgba(0,0,0,0.06); border-radius:20px; background:#fff; }
    .status-pending{ background:#fff7e6; color:#b7791f; border:1px solid #fde68a; }
    .status-shipped{ background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe; }
    .status-delivered{ background:#ecfdf5; color:#047857; border:1px solid #a7f3d0; }
    @@media (max-width: 576px) {
        .item-row { align-items: flex-start !important; }
        .item-row img { width: 54px !important; height: 54px !important; }
        .item-price { font-size: 13px !important; }
    }
</style>

<div class="container py-4 py-lg-5" style="max-width:900px; overflow-x:hidden;">
    <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
        <a asp-action="MyOrders" class="bg-white border rounded-circle d-inline-flex align-items-center justify-content-center text-decoration-none text-dark shadow-sm" style="width:36px;height:36px;"><i class="fa-solid fa-arrow-left" style="font-size:12px;"></i></a>
        <h4 class="fw-bolder mb-0">Order Details</h4>
        @{
            var statusClass = Model.Status == "Delivered" ? "status-delivered" : Model.Status == "Shipped" ? "status-shipped" : "status-pending";
        }
        <span class="badge rounded-pill @statusClass ms-auto" style="font-size:11px; padding:7px 12px;"><i class="fa-solid fa-circle me-1" style="font-size:7px;"></i>@Model.Status</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="detail-card p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <h6 class="fw-bold mb-0">Items (@Model.OrderItems.Sum(i => i.Quantity))</h6>
                    <span class="small text-muted">Order #@Model.Id • @Model.OrderDate.ToString("dd MMM yyyy")</span>
                </div>

                @foreach(var item in Model.OrderItems)
                {
                    var imgPath = item.Product!.Image ?? "";
                    if (!imgPath.StartsWith("/") && !imgPath.StartsWith("http")) { imgPath = "/" + imgPath.TrimStart('~','/'); }
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3 item-row">
                        <div class="d-flex gap-3 align-items-center" style="min-width:0;">
                            <img src="@Url.Content(imgPath)" style="width:64px;height:64px;object-fit:contain;background:#f6f7f9;border-radius:14px;padding:6px; flex-shrink:0;" onerror="this.src='https://placehold.co/100x100?text=No+Image'" />
                            <div style="min-width:0;">
                                <div class="fw-semibold text-truncate" style="font-size:14px; max-width:180px;">@item.Product!.Name</div>
                                <div class="small text-muted mt-1">@item.Product!.Category • Qty: @item.Quantity x Rs. @item.Price.ToString("N0")</div>
                            </div>
                        </div>
                        <div class="fw-bolder text-end item-price ms-2" style="font-size:14px; white-space:nowrap;">Rs. @((item.Quantity * item.Price).ToString("N0"))</div>
                    </div>
                }

                <div class="mt-4">
                    <div class="d-flex justify-content-between small text-muted mb-2"><span>Subtotal</span><span>Rs. @subtotalBeforeDiscount.ToString("N0")</span></div>
                    <div class="d-flex justify-content-between small text-success fw-semibold mb-2"><span>Discount (10%)</span><span>- Rs. @discount.ToString("N0")</span></div>
                    <div class="d-flex justify-content-between small text-muted mb-3"><span>Shipping</span><span class="text-success fw-bold">Free</span></div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bolder fs-5"><span>Total Paid</span><span>Rs. @Model.TotalAmount.ToString("N0")</span></div>
                    <div class="small text-muted mt-1"><i class="fa-solid fa-money-bill-wave me-1"></i>@Model.PaymentMethod</div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="detail-card p-4 mb-3">
                <h6 class="fw-bold mb-3"><i class="fa-solid fa-user me-2"></i>Customer</h6>
                <div class="small"><div class="fw-semibold">@Model.CustomerName</div><div class="text-muted mt-1"><i class="fa-solid fa-phone me-1"></i>@Model.Phone</div><div class="text-muted mt-2" style="word-break:break-word;"><i class="fa-solid fa-location-dot me-1"></i>@Model.Address</div></div>
            </div>
            <div class="detail-card p-4 bg-dark text-white">
                <div class="small opacity-75 mb-2"><i class="fa-solid fa-shield-halved me-1"></i>Need Help?</div>
                <div class="fw-bold" style="line-height:1.6;">This order is @Model.Status.ToLower(). If delivered, you can request return within 7 days.</div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-light w-100 rounded-3 mt-3 fw-bold btn-sm">Continue Shopping</a>
            </div>
        </div>
    </div>
</div>