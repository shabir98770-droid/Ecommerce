@model Ecommerce.Models.Product
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>
    .details-hero {
        background: radial-gradient(120% 120% at 20% 10%, #ffffff 0%, #f5f5f7 60%, #eef0f3 100%);
        border-radius: 28px;
        position: relative;
        overflow: hidden;
        min-height: 400px;
        height: 560px;
    }
    .details-hero::after {
        content: ""; position: absolute; width: 400px; height: 400px;
        background: radial-gradient(circle, rgba(0,0,0,0.05) 0%, transparent 70%);
        top: -100px; right: -100px;
    }
    .price-box { background: #000; color: #fff; border-radius: 16px; padding: 18px 22px; }
    .spec-pill {
        background: #f5f5f7; border: 1px solid #ececef; border-radius: 999px;
        padding: 8px 14px; font-size: 12px; font-weight: 600; white-space: nowrap; flex-shrink: 0;
    }
    .qty-box { background: #f5f5f7; border-radius: 14px; padding: 6px; }
    .qty-btn {
        width: 38px; height: 38px; border: 0; background: #fff;
        border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); font-weight: 800;
    }
    /* ===== MOBILE FIX FOR THIS PAGE ONLY ===== */
    @@media (max-width: 991px) {
        .details-hero { height: 380px !important; min-height: 380px; border-radius: 22px; }
    }
    @@media (max-width: 576px) {
        .details-hero { height: 320px !important; min-height: 320px; border-radius: 18px; }
        .spec-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; flex-wrap: nowrap !important; }
        .spec-scroll::-webkit-scrollbar { display: none; }
        h1 { font-size: 28px !important; }
        .price-box { padding: 14px 16px !important; }
        .price-box .fs-3 { font-size: 22px !important; }
    }
</style>

<div class="container py-4 py-lg-5" style="overflow-x:hidden;">
    <a asp-action="Index" class="text-decoration-none small fw-bold text-muted mb-4 d-inline-flex align-items-center gap-2">
        <span class="bg-white border rounded-circle d-inline-flex align-items-center justify-content-center" style="width:32px;height:32px;"><i class="fa-solid fa-arrow-left" style="font-size:12px;"></i></span> Back to Products
    </a>

    <div class="row g-4 g-lg-5">
        <!-- LEFT -->
        <div class="col-lg-6">
            @{
                var imgPath = Model.Image ?? "";
                if (!imgPath.StartsWith("/") && !imgPath.StartsWith("http")) { imgPath = "/" + imgPath.TrimStart('~','/'); }
            }
            <div class="details-hero border shadow-sm d-flex align-items-center justify-content-center p-4 p-lg-5">
                <img src="@Url.Content(imgPath)" class="img-fluid" style="max-height:100%; max-width:100%; object-fit:contain; mix-blend-mode:multiply; position:relative; z-index:2;" alt="@Model.Name" onerror="this.src='https://placehold.co/600x600?text=@Model.Name'" />
            </div>
            <div class="d-flex gap-2 mt-3 spec-scroll">
                <div class="spec-pill"><i class="fa-solid fa-shield-halved me-1"></i> PTA Approved</div>
                <div class="spec-pill"><i class="fa-solid fa-bolt me-1"></i> Fast Delivery</div>
                <div class="spec-pill"><i class="fa-solid fa-award me-1"></i> Official Warranty</div>
            </div>
        </div>

        <!-- RIGHT -->
        <div class="col-lg-6">
            <span class="badge bg-white text-dark border shadow-sm rounded-4 px-3 py-2 mb-3">@Model.Category</span>
            <h1 class="fw-bolder mb-2" style="letter-spacing:-0.8px; line-height:1.1; text-transform:capitalize; word-break:break-word;">@Model.Name</h1>

            <div class="d-flex align-items-center gap-3 mt-3 flex-wrap">
                <div class="text-warning small"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star-half-stroke"></i></div>
                <span class="small text-muted fw-semibold">4.8 (1.2k reviews)</span>
                <span class="small text-success fw-bold"><i class="fa-solid fa-circle-check me-1"></i> In Stock</span>
            </div>

            <div class="price-box d-flex align-items-center justify-content-between mt-4">
                <div>
                    <div class="small opacity-75">Special Price</div>
                    <div class="fs-3 fw-bolder">Rs. @Model.Price.ToString("N0")</div>
                </div>
                <div class="text-end">
                    <div class="text-decoration-line-through opacity-50 small">Rs. @((Model.Price * 1.2m).ToString("N0"))</div>
                    <span class="badge bg-danger rounded-3">20% OFF</span>
                </div>
            </div>

            <div class="mt-4 p-3 bg-light rounded-4" style="line-height:1.9;">
                <h6 class="fw-bold mb-2 small text-uppercase">About Product</h6>
                <p class="text-muted small mb-0">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        @Model.Description
                    }
                    else
                    {
                        if (Model.Category.ToLower().Contains("mobile"))
                        {
                            <span>@Model.Name is a premium smartphone with powerful performance, stunning display and long-lasting battery. Perfect for daily use, gaming and photography. 100% original with PTA approved and official warranty. Free delivery in Islamabad.</span>
                        }
                        else if (Model.Category.ToLower().Contains("laptop"))
                        {
                            <span>@Model.Name comes with high-speed processor, sleek design and powerful battery backup. Best for students, office work and programming. Original product with 1 year warranty and free bag included.</span>
                        }
                        else
                        {
                            <span>@Model.Name is a high-quality @Model.Category product with premium build quality and excellent performance. 100% original and comes with official warranty.</span>
                        }
                    }
                </p>
            </div>

            <div class="d-flex align-items-center gap-3 mt-4 flex-wrap">
                <div class="qty-box d-flex align-items-center gap-2">
                    <button class="qty-btn" type="button" onclick="changeQty(-1)">-</button>
                    <span id="qty" class="fw-bolder px-2" style="min-width:24px; text-align:center;">1</span>
                    <button class="qty-btn" type="button" onclick="changeQty(1)">+</button>
                </div>
                <span class="small text-muted fw-semibold">Quantity</span>
                <span class="ms-lg-auto small text-success fw-bold"><i class="fa-solid fa-truck-fast me-1"></i> Free Delivery in 2-3 Days</span>
            </div>

            <div class="d-grid gap-2 mt-4">
                <a id="addToCartBtn" asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@Model.Id" class="btn btn-dark py-3 rounded-4 fw-bold shadow-lg">
                    <i class="fa-solid fa-bag-shopping me-2"></i> Add to Cart - Rs. @Model.Price.ToString("N0")
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-light w-100 py-3 rounded-4 fw-semibold border" style="background:#f5f5f7;">Continue Shopping</a>
                    <button class="btn btn-white border rounded-4 px-4"><i class="fa-regular fa-heart"></i></button>
                </div>
            </div>

            <div class="mt-4 p-3 bg-white border rounded-4 small shadow-sm">
                <div class="d-flex justify-content-between py-2 border-bottom"><span><i class="fa-solid fa-rotate-left me-2 text-success"></i> 7 Days Return</span><b>Easy Return</b></div>
                <div class="d-flex justify-content-between py-2"><span><i class="fa-solid fa-shield-halved me-2 text-success"></i> Warranty</span><b>1 Year Official</b></div>
            </div>
        </div>
    </div>
</div>

<script>
    let q = 1;
    function changeQty(v) {
        q = Math.max(1, Math.min(10, q + v));
        document.getElementById('qty').innerText = q;
        const btn = document.getElementById('addToCartBtn');
        if(btn) btn.href = `/Cart/AddToCart?productId=@Model.Id&quantity=${q}`;
    }
</script>