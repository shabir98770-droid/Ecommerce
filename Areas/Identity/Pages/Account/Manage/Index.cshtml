@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .profile-wrap{background:#f6f7f9; min-height:100vh; padding:40px 0;}
    .left-card{border-radius:20px; overflow:hidden;}
    .nav-pills .nav-link{color:#6b7280; padding:12px 16px; font-size:14px; border-radius:12px;}
    .nav-pills .nav-link:hover{background:#f3f4f6; color:#111;}
    .nav-pills .nav-link.active{background:#111 !important; color:#fff !important;}
    .logout-btn{border-radius:12px; padding:12px; border:1px solid #fee2e2; color:#dc2626; background:#fff5f5; font-weight:600; font-size:14px; width:100%;}
    .logout-btn:hover{background:#dc2626; color:#fff;}
</style>

<div class="profile-wrap">
<div class="container">
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm left-card p-2">
                <div class="text-center p-4" style="background:#0a0a0a; border-radius:16px; color:#fff;">
                    <div class="mx-auto rounded-circle d-flex align-items-center justify-content-center" style="width:64px; height:64px; background: linear-gradient(135deg,#6366f1,#ec4899); font-weight:900; font-size:26px;">
                        @(Model.Username?.Substring(0,1).ToUpper() ?? "K")
                    </div>
                    <h6 class="mt-3 mb-1 fw-bold text-white">@Model.Username</h6>
                    <small style="opacity:0.5; font-size:12px;">Customer Account</small>
                </div>

                <div class="nav flex-column nav-pills mt-3 gap-1 px-1" role="tablist">
                    <button class="nav-link active text-start" data-bs-toggle="pill" data-bs-target="#profile"><i class="bi bi-person me-2"></i> Profile</button>
                    <button class="nav-link text-start" data-bs-toggle="pill" data-bs-target="#password"><i class="bi bi-lock me-2"></i> Password</button>
                    <a href="/Orders" class="nav-link text-start"><i class="bi bi-bag me-2"></i> My Orders</a>
                    <a href="/Identity/Account/Manage/PersonalData" class="nav-link text-start"><i class="bi bi-shield me-2"></i> Personal Data</a>
                </div>

                <hr class="my-3" />

                <button class="logout-btn" data-bs-toggle="modal" data-bs-target="#logoutModal">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </button>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="tab-content">
                <div class="tab-pane fade show active" id="profile">
                    <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5">
                        <h4 class="fw-bolder" style="letter-spacing:-0.5px;">Profile Settings</h4>
                        <p class="text-muted small mb-4">Your email and phone for orders.</p>
                        <partial name="_StatusMessage" for="StatusMessage" />
                        <form id="profile-form" method="post">
                            <div class="mb-3">
                                <label class="small fw-bold" style="font-size:11px; opacity:0.6;">EMAIL</label>
                                <input asp-for="Username" class="form-control py-3 rounded-4 bg-light" disabled />
                            </div>
                            <div class="mb-4">
                                <label asp-for="Input.PhoneNumber" class="small fw-bold" style="font-size:11px; opacity:0.6;">PHONE NUMBER</label>
                                <input asp-for="Input.PhoneNumber" class="form-control py-3 rounded-4" placeholder="0300-1234567" />
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                            </div>
                            <button type="submit" class="btn btn-dark w-100 py-3 rounded-4 fw-bold">Save Changes</button>
                        </form>
                    </div>
                </div>

                <div class="tab-pane fade" id="password">
                    <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5">
                        <h4 class="fw-bolder">Change Password</h4>
                        <p class="text-muted small mb-4">Update your password from here.</p>
                        <form method="post" action="/Identity/Account/Manage/ChangePassword">
                            <div class="mb-3"><input name="Input.OldPassword" type="password" class="form-control py-3 rounded-4" placeholder="Current Password" required /></div>
                            <div class="mb-3"><input name="Input.NewPassword" type="password" class="form-control py-3 rounded-4" placeholder="New Password" required /></div>
                            <div class="mb-4"><input name="Input.ConfirmPassword" type="password" class="form-control py-3 rounded-4" placeholder="Confirm New Password" required /></div>
                            <button type="submit" class="btn btn-dark w-100 py-3 rounded-4 fw-bold">Update Password</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<!-- LOGOUT WARNING MODAL - FIXED -->
<div class="modal fade" id="logoutModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-body p-5 text-center">
        <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center" style="width:64px; height:64px; background:#fff5f5; color:#dc2626;"><i class="bi bi-exclamation-triangle fs-3"></i></div>
        <h5 class="fw-bolder">Logout from ECOMMERCE.?</h5>
        <p class="small text-muted mt-2" style="line-height:1.6;">You are about to logout from your account. You will need to login again to access your orders and profile. Are you sure?</p>
        <div class="row g-2 mt-4">
            <div class="col-6"><button type="button" class="btn btn-light w-100 rounded-4 py-2 fw-semibold" data-bs-dismiss="modal">Cancel</button></div>
            <div class="col-6">
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                    <button type="submit" class="btn btn-danger w-100 rounded-4 py-2 fw-bold">Yes, Logout</button>
                </form>
            </div>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}