@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-5" style="max-width:600px;">
    <div class="card border-0 shadow-sm rounded-4 p-5">
        <h4 class="fw-bolder">Change Password</h4>
        <partial name="_StatusMessage" for="StatusMessage" />
        <form method="post" class="mt-4">
            <div class="mb-3"><label class="small fw-bold">Old Password</label><input asp-for="Input.OldPassword" class="form-control py-3 rounded-4" /></div>
            <div class="mb-3"><label class="small fw-bold">New Password</label><input asp-for="Input.NewPassword" class="form-control py-3 rounded-4" /></div>
            <div class="mb-4"><label class="small fw-bold">Confirm Password</label><input asp-for="Input.ConfirmPassword" class="form-control py-3 rounded-4" /></div>
            <button type="submit" class="btn btn-dark w-100 py-3 rounded-4 fw-bold">Update Password</button>
            <a href="/Identity/Account/Manage" class="btn btn-outline-secondary w-100 rounded-4 mt-2">Back to Profile</a>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }