@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password reset";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body { background: #f6f6f6 !important; }
    .lux-card {
        background: white;
        border-radius: 32px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.08);
        max-width: 480px;
        width: 100%;
        padding: 48px 40px;
        margin: 20px auto;
        text-align: center;
    }
    .icon-circle {
        width: 72px;
        height: 72px;
        background: #000;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        font-size: 28px;
    }
    .lux-btn {
        background: #0a0a0a;
        color: white;
        border-radius: 14px;
        padding: 18px;
        width: 100%;
        font-size: 16px;
        font-weight: 500;
        border: none;
        display: block;
        text-decoration: none;
    }
    .brand { font-family: serif; font-size: 22px; }
</style>

<div class="d-flex justify-content-center align-items-center" style="min-height:75vh;">
    <div class="lux-card">
        <div class="brand mb-4">Ecommerce.</div>
        
        <div class="icon-circle">✓</div>
        <h2 class="fw-normal" style="font-size:26px;">Password reset!</h2>
        <p class="text-muted small mt-3" style="line-height:1.6;">
            Your password has been reset successfully.<br/>
            You can now log in with your new password.
        </p>

        <a asp-page="./Login" class="lux-btn mt-4">Log in now</a>

        <a href="/" class="text-muted small text-decoration-none d-block mt-4">Go to homepage</a>
    </div>
</div>