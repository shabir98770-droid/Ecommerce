@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body { background: #f6f6f6 !important; }
    .lux-card {
        background: white;
        border-radius: 32px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.08);
        max-width: 480px;
        width: 100%;
        padding: 48px 40px;
        margin: 20px auto;
    }
    .lux-label { font-size: 12px; letter-spacing: 1.5px; font-weight: 600; text-transform: uppercase; margin-bottom: 10px; }
    .lux-input { background: #f2f2f2; border: 1px solid #e5e5e5; border-radius: 14px; padding: 16px 18px; font-size: 15px; width: 100%; }
    .lux-input:focus { outline: none; background: #fff; border-color: #000; }
    .lux-btn { background: #0a0a0a; color: white; border-radius: 14px; padding: 18px; width: 100%; font-size: 16px; font-weight: 500; border: none; }
    .brand { font-family: serif; font-size: 22px; }
</style>

<div class="d-flex justify-content-center align-items-center" style="min-height:75vh;">
    <div class="lux-card">
        <div class="text-center mb-5">
            <div class="brand mb-4">Ecommerce.</div>
            <h2 class="fw-normal" style="font-size:26px;">Resend confirmation</h2>
            <p class="text-muted small mt-2" style="line-height:1.6;">Enter your email, we'll send you a new confirmation link</p>
        </div>

        <form method="post">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <div class="mb-4">
                <div class="lux-label">Email Address</div>
                <input asp-for="Input.Email" class="lux-input" placeholder="name@example.com" aria-required="true" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="lux-btn">Resend link</button>

            <div class="text-center mt-4" style="font-size:14px;">
                <a asp-page="./Login" class="text-dark fw-bold" style="text-decoration:underline; text-underline-offset:4px;">Back to Log in</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}