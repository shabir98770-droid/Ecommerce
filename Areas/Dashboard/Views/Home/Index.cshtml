@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dash-card{
        border:0 !important; border-radius:18px !important;
        box-shadow:0 8px 30px rgba(0,0,0,0.06) !important;
        transition: all .3s ease; overflow:hidden;
    }
    .dash-card:hover{ transform: translateY(-5px); box-shadow:0 15px 40px rgba(0,0,0,0.1) !important; }
    .border-left-primary{ border-left:5px solid #4e73df !important; }
    .border-left-success{ border-left:5px solid #1cc88a !important; }
    .border-left-info{ border-left:5px solid #36b9cc !important; }
    .border-left-warning{ border-left:5px solid #f6c23e !important; }
    
    @@media (max-width: 576px) {
        .h3{ font-size:1.3rem !important; }
        .quick-links .btn{ width:100%; margin-bottom:10px; margin-right:0 !important; }
    }
</style>

<div class="container-fluid px-2 px-lg-4" style="overflow-x:hidden;">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <h1 class="h3 mb-0 text-gray-800 fw-bold" style="letter-spacing:-0.5px;">Dashboard</h1>
        <a href="/Dashboard/Home/Orders" class="btn btn-dark rounded-pill px-4 btn-sm shadow-sm">
            <i class="fas fa-list me-2"></i> View All Orders
        </a>
    </div>

    <!-- Cards Row -->
    <div class="row g-3">
        <div class="col-6 col-xl-3">
            <div class="card dash-card border-left-primary h-100 py-2">
                <div class="card-body p-3 p-lg-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs fw-bold text-primary text-uppercase mb-1" style="font-size:10px; letter-spacing:1px;">TOTAL PRODUCTS</div>
                            <div class="h5 mb-0 fw-bolder text-gray-800">@ViewBag.TotalProducts</div>
                        </div>
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 d-none d-md-flex">
                            <i class="fas fa-box fa-lg text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card dash-card border-left-success h-100 py-2">
                <div class="card-body p-3 p-lg-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs fw-bold text-success text-uppercase mb-1" style="font-size:10px; letter-spacing:1px;">EARNINGS</div>
                            <div class="h5 mb-0 fw-bolder text-gray-800" style="font-size:1.1rem;">Rs. @Convert.ToDecimal(ViewBag.TotalSales ?? 0).ToString("N0")</div>
                        </div>
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 d-none d-md-flex">
                            <i class="fas fa-dollar-sign fa-lg text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card dash-card border-left-info h-100 py-2">
                <div class="card-body p-3 p-lg-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs fw-bold text-info text-uppercase mb-1" style="font-size:10px; letter-spacing:1px;">TOTAL ORDERS</div>
                            <div class="h5 mb-0 fw-bolder text-gray-800">@ViewBag.TotalOrders</div>
                        </div>
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 d-none d-md-flex">
                            <i class="fas fa-shopping-cart fa-lg text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card dash-card border-left-warning h-100 py-2">
                <div class="card-body p-3 p-lg-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs fw-bold text-warning text-uppercase mb-1" style="font-size:10px; letter-spacing:1px;">PENDING</div>
                            <div class="h5 mb-0 fw-bolder text-gray-800">@ViewBag.PendingOrders</div>
                        </div>
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 d-none d-md-flex">
                            <i class="fas fa-clock fa-lg text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Links Row -->
    <div class="row mt-2">
        <div class="col-lg-12">
            <div class="card dash-card shadow mb-4 mt-3">
                <div class="card-header py-3 bg-white border-0"><h6 class="m-0 fw-bold text-dark">Quick Links</h6></div>
                <div class="card-body text-center quick-links p-4">
                    <a href="/Dashboard/Products" class="btn btn-dark rounded-pill px-4 py-2 fw-semibold me-2 mb-2"><i class="fas fa-box me-2"></i>Manage Products</a>
                    <a href="/Dashboard/Home/Orders" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold me-2 mb-2"><i class="fas fa-receipt me-2"></i>All Orders List</a>
                    <a href="/" class="btn btn-light rounded-pill px-4 py-2 fw-semibold mb-2" style="background:#f6f6f6;"><i class="fas fa-globe me-2"></i>Go to Website</a>
                </div>
            </div>
        </div>
    </div>
</div>