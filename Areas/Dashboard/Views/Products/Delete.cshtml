@model Ecommerce.Models.Product
@{
    ViewData["Title"] = "Delete";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0 rounded-4 overflow-hidden mt-4">
                <div class="card-header bg-danger bg-gradient text-white border-0 py-4 px-4">
                    <h5 class="m-0 fw-bold"><i class="fas fa-exclamation-triangle me-2"></i> Delete Confirmation</h5>
                    <small class="opacity-75">This action cannot be undone</small>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-danger bg-danger-subtle border-0 rounded-3 py-3">
                        <h6 class="fw-bold mb-1 text-danger">Are you sure you want to delete this product?</h6>
                        <small class="text-muted">Once deleted, all its data will be permanently removed.</small>
                    </div>

                    <div class="row align-items-center mt-4">
                        <div class="col-md-4 text-center">
                            <div class="position-relative d-inline-block">
                                @if (!string.IsNullOrEmpty(Model.Image))
                                {
                                    <img src="@Model.Image" class="rounded-4 shadow-sm" style="width:100%; max-height:220px; object-fit:cover; border:4px solid #fff;" />
                                }
                                else
                                {
                                    <div class="bg-light rounded-4 p-5 text-center border border-dashed">
                                        <div style="font-size:40px;">🖼️</div>
                                        <small class="text-muted">No Image</small>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-8 mt-4 mt-md-0">
                            <div class="bg-light rounded-3 p-3">
                                <div class="mb-3">
                                    <small class="text-uppercase text-muted fw-bold" style="font-size:11px; letter-spacing:1px;">Product Name</small>
                                    <h6 class="fw-bold mb-0">@Model.Name</h6>
                                </div>
                                <div class="mb-3">
                                    <small class="text-uppercase text-muted fw-bold" style="font-size:11px; letter-spacing:1px;">Description</small>
                                    <p class="mb-0 small text-muted">@Model.Description</p>
                                </div>
                                <div>
                                    <small class="text-uppercase text-muted fw-bold" style="font-size:11px; letter-spacing:1px;">Price</small>
                                    <h5 class="fw-bold text-primary mb-0">Rs. @Model.Price</h5>
                                </div>
                            </div>

                            <form asp-action="Delete" method="post" class="mt-4 d-flex gap-2">
                                <input type="hidden" asp-for="Id" />
                                <button type="submit" class="btn btn-danger rounded-3 px-4 py-2 fw-bold shadow-sm flex-fill">
                                    Yes, Delete It
                                </button>
                                <a asp-action="Index" class="btn btn-light border rounded-3 px-4 py-2 fw-semibold flex-fill text-center">
                                    Cancel
                                </a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>