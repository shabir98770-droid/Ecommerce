@model Ecommerce.Models.Product
@{
    ViewData["Title"] = "Details";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Product Details</h1>
        <a asp-area="Dashboard" asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-3 px-3">← Back to List</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-4 overflow-hidden">
                <div class="row g-0">
                    
                    <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img src="@Model.Image" class="img-fluid rounded-4 shadow-sm" style="width:100%; max-height:380px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <div style="font-size:60px;">🖼️</div>
                                <p class="text-muted small mt-2">No Image Available</p>
                            </div>
                        }
                    </div>

                    <!-- Info Side -->
                    <div class="col-md-7">
                        <div class="card-body p-4 p-lg-5">
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-3" style="font-size:11px; letter-spacing:1px;">PRODUCT #@Model.Id</span>
                            
                            <h2 class="fw-bold mb-2" style="letter-spacing:-0.5px;">@Model.Name</h2>
                            
                            <div class="d-flex align-items-center mb-4">
                                <h3 class="text-primary fw-bold mb-0">Rs. @Model.Price</h3>
                                <span class="badge bg-success-subtle text-success ms-3 rounded-3">In Stock</span>
                            </div>

                            <div class="mb-4">
                                <small class="text-uppercase text-muted fw-bold" style="font-size:11px; letter-spacing:1px;">Description</small>
                                <p class="text-muted mt-2" style="line-height:1.7;">@Model.Description</p>
                            </div>

                            <div class="bg-light rounded-3 p-3 mb-4">
                                <div class="row small">
                                    <div class="col-6">
                                        <span class="text-muted">Image Path</span>
                                        <div class="text-truncate fw-semibold" title="@Model.Image">@Model.Image</div>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted">Product ID</span>
                                        <div class="fw-semibold">@Model.Id</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-area="Dashboard" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-3 px-4 py-2 fw-bold shadow-sm">
                                    <i class="fas fa-edit me-1"></i> Edit Product
                                </a>
                                <a asp-area="Dashboard" asp-controller="Products" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-3 px-4 py-2">
                                    Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>