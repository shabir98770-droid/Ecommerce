@model Ecommerce.Models.Product
@{
    ViewData["Title"] = "Create";
}

<div class="container-fluid">
   
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary bg-gradient rounded-3 d-flex align-items-center justify-content-center" style="width:48px; height:48px;">
                <i class="fas fa-box text-white"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold text-gray-800">Add New Product</h1>
                <small class="text-muted">Create a new product for your store</small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-light border rounded-3 px-4 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2">
                <i class="fas fa-arrow-left small"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom py-3 px-4 rounded-top-4">
                    <div class="d-flex align-items-center gap-2">
                        <span class="bg-primary-subtle text-primary rounded-2 p-2"><i class="fas fa-info-circle"></i></span>
                        <div>
                            <h6 class="m-0 fw-bold">Product Information</h6>
                            <small class="text-muted" style="font-size:12px;">All fields are required</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-lg-5">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                        <div class="row g-4">
                            <!-- Left Side Form -->
                            <div class="col-md-7">
                                <div class="form-group mb-4">
                                    <label asp-for="Name" class="form-label fw-semibold small">Product Name <span class="text-danger">*</span></label>
                                    <input asp-for="Name" class="form-control rounded-3 py-2 px-3" placeholder="e.g. iPhone 15 Pro" />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>

                                
                                <div class="form-group mb-4">
                                    <label asp-for="Category" class="form-label fw-semibold small">Category <span class="text-danger">*</span></label>
                                    <select asp-for="Category" class="form-control rounded-3 py-2 px-3 fw-semibold">
                                        <option value="">-- Select Category --</option>
                                        <option value="Mobile">Mobile</option>
                                        <option value="Laptop">Laptop</option>
                                    </select>
                                    <span asp-validation-for="Category" class="text-danger small"></span>
                                </div>

                                <div class="form-group mb-4">
                                    <label asp-for="Description" class="form-label fw-semibold small">Description <span class="text-danger">*</span></label>
                                    <textarea asp-for="Description" class="form-control rounded-3 px-3 py-3" rows="4" placeholder="Write a short and clear description..."></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>

                                <div class="form-group mb-4">
                                    <label asp-for="Price" class="form-label fw-semibold small">Price <span class="text-danger">*</span></label>
                                    <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                        <span class="input-group-text bg-light border-0 fw-bold px-3">Rs.</span>
                                        <input asp-for="Price" class="form-control border-0 py-2" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Right Side Image -->
                            <div class="col-md-5">
                                <label class="form-label fw-semibold small w-100">Product Image <span class="text-danger">*</span></label>
                                <div class="card border-2 border-dashed rounded-4 bg-light bg-opacity-50 p-2 text-center overflow-hidden" style="border-style: dashed!important;">
                                    <img id="preview" src="#" alt="Preview" style="display:none; width:100%; height:220px; object-fit:cover; border-radius:12px;" />
                                    <div id="placeholder" class="py-5">
                                        <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm mb-3" style="width:64px; height:64px;">
                                            <i class="fas fa-cloud-upload-alt text-primary fs-4"></i>
                                        </div>
                                        <p class="small fw-semibold mb-1">Upload Product Image</p>
                                        <small class="text-muted" style="font-size:11px;">PNG, JPG up to 5MB</small>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <input type="file" name="ImageFile" id="ImageFile" class="form-control rounded-3" accept="image/*" onchange="previewImage(event)" required />
                                </div>
                            </div>
                        </div>

                        <!-- Bottom Actions -->
                        <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-light border rounded-3 px-4 py-2 fw-semibold">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-3 px-5 py-2 fw-bold shadow">
                                <i class="fas fa-check me-2"></i> Create Product
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function previewImage(event) {
            var preview = document.getElementById('preview');
            var placeholder = document.getElementById('placeholder');
            preview.style.display = 'block';
            placeholder.style.display = 'none';
            preview.src = URL.createObjectURL(event.target.files[0]);
        }
    </script>
}